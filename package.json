{
  "name": "leeprky-engineering-portfolio",
  "version": "9.0.0",
  "description": "Lee Parkinson — Electrical Engineering Blueprint Portfolio powered by GSAP, Lenis Smooth Scroll, and React Bits",
  "homepage": "https://leeprky.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/leeprky/leeprky.github.io.git"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.27"
  },
  "gsapSkills": {
    "repository": "https://github.com/greensock/gsap-skills",
    "skillsPath": ".agents/skills",
    "skills": [
      "gsap-core",
      "gsap-timeline",
      "gsap-scrolltrigger",
      "gsap-plugins",
      "gsap-utils",
      "gsap-react",
      "gsap-performance",
      "gsap-frameworks"
    ]
  },
  "reactBits": {
    "repository": "https://github.com/DavidHDev/react-bits",
    "website": "https://www.reactbits.dev/",
    "vendoredPath": "assets/vendor/react-bits",
    "components": [
      "ElectricBorder",
      "SpotlightCard",
      "TiltedCard",
      "DecryptedText",
      "SplitText",
      "Magnet",
      "ScrollVelocity",
      "ShinyText",
      "Dock",
      "DraftingCursor",
      "MagicBento",
      "MetallicSwirl",
      "TechText",
      "SatinRidges"
    ]
  },
  "lenis": {
    "repository": "https://github.com/darkroomengineering/lenis",
    "bundle": "assets/vendor/lenis.min.js",
    "stylesheet": "assets/vendor/lenis.css"
  },
  "vendorBundles": {
    "gsap": "assets/vendor/gsap.min.js",
    "scrollTrigger": "assets/vendor/ScrollTrigger.min.js",
    "scrollTo": "assets/vendor/ScrollToPlugin.min.js",
    "splitText": "assets/vendor/SplitText.min.js",
    "scrambleText": "assets/vendor/ScrambleTextPlugin.min.js",
    "flip": "assets/vendor/Flip.min.js",
    "textPlugin": "assets/vendor/TextPlugin.min.js",
    "lenis": "assets/vendor/lenis.min.js",
    "lenisCss": "assets/vendor/lenis.css",
    "blueprintMotionCss": "assets/vendor/blueprint-motion.css",
    "blueprintMotionJs": "assets/vendor/blueprint-motion.js"
  },
  "license": "MIT"
}
